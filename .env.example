# PaperSeek Community deployment defaults.
# Copy this file to `.env`; Docker Compose then passes those values to the
# container. When running `paperseek serve` directly, export the same names.
# Never commit real credentials.

# Docker image version. Prereleases do not update the latest tag.
PAPERSEEK_VERSION=1.0.0-beta4

# Docker publishes only to this machine by default. Keep container port 8765.
PAPERSEEK_HOST=127.0.0.1
PAPERSEEK_PORT=8765

# Optional local CLI/serve database path. Compose sets its own volume path.
# PAPERSEEK_DATABASE=C:/path/to/paperseek.db

PAPERSEEK_LLM_API_TYPE=openai_responses
PAPERSEEK_LLM_BASE_URL=https://api.openai.com/v1
PAPERSEEK_LLM_MODEL=gpt-5.6-luna
PAPERSEEK_LLM_API_KEY=

# Optional source credentials.
PAPERSEEK_OPENALEX_API_KEY=
PAPERSEEK_SEMANTIC_SCHOLAR_API_KEY=
PAPERSEEK_PUBMED_API_KEY=
PAPERSEEK_WOS_API_KEY=
PAPERSEEK_WOS_DB=WOS
PAPERSEEK_GOOGLE_SCHOLAR_API_KEY=

# Optional HTTP(S) proxy pool, one URL per line or comma-separated. When set, it
# replaces the proxy saved in Settings. Never put real credentials in Git.
# PAPERSEEK_PROXY_URLS=http://user:password@proxy.example:8080
PAPERSEEK_PROXY_URLS=
# What goes through the pool: models, ip_limited_sources, other_sources (default: all three).
PAPERSEEK_PROXY_SCOPE=

# Searches and reviews that run at the same time; 0 removes the limit.
PAPERSEEK_MAX_CONCURRENT_RUNS=4
